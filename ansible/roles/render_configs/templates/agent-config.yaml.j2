{{ '#' }} Rendered by Ansible role render_configs — {{ network_profile | default('private-vlan') }} SNO agent-config.
{{ '#' }} additionalNTPSources lives HERE (the installer drops it from install-config — fix #3).
{{ '#' }} NIC names are bound to discovered MACs; topology is selected explicitly.
apiVersion: v1beta1
kind: AgentConfig
metadata:
  name: {{ cluster_name }}
rendezvousIP: {{ cluster_node_ip | default(node_vlan_ip) }}
bootArtifactsBaseURL: {{ boot_artifacts_base_url }}
additionalNTPSources:
{% for ntp in additional_ntp_sources %}
  - {{ ntp }}
{% endfor %}
hosts:
{% for m in discovery_machines | default(machines) %}
  - hostname: {{ m.name }}
    role: {{ m.role }}
    rootDeviceHints:
      deviceName: {{ m.root_device }}
    interfaces:
{% if m.bond_ports | default([]) %}
{% for port in m.bond_ports %}
      - name: {{ port.name }}
        macAddress: {{ port.mac }}
{% endfor %}
{% else %}
      - name: {{ m.parent_if }}
        macAddress: {{ m.parent_mac }}
{% endif %}
{% if m.external_if is defined and m.external_if and m.external_mac is defined and m.external_mac %}
      {{ '#' }} Bind the PUBLIC NIC's name to its DISCOVERED mac (#80). This list is the
      {{ '#' }} name<->MAC mapping the installer applies, so declaring it here makes
      {{ '#' }} `{{ m.external_if }}` authoritative for {{ m.external_mac }} instead of an assumed
      {{ '#' }} name that merely happens to match this SKU's PCI enumeration. Without it, the
      {{ '#' }} networkConfig stanza below could name a device that does not exist, the public NIC
      {{ '#' }} would go unmanaged again, and #78 would silently return.
      - name: {{ m.external_if }}
        macAddress: {{ m.external_mac }}
{% endif %}
    networkConfig:
      interfaces:
        - name: {{ m.parent_if }}
          type: {{ 'bond' if m.bond_ports | default([]) else 'ethernet' }}
{% if m.bond_ports | default([]) %}
          link-aggregation:
            mode: {{ m.bond_mode }}
            options:
              miimon: '100'
              lacp_rate: slow
              xmit_hash_policy: layer3+4
            port:
{% for port in m.bond_ports %}
              - {{ port.name }}
{% endfor %}
{% endif %}
          state: up
          ipv4:
            enabled: false
          ipv6:
            enabled: false
{% for port in m.bond_ports | default([]) %}
        - name: {{ port.name }}
          type: ethernet
          state: up
          ipv4:
            enabled: false
            dhcp: false
          ipv6:
            enabled: false
            dhcp: false
            autoconf: false
{% endfor %}
{% if m.external_if is defined and m.external_if and m.external_mac is defined and m.external_mac %}
        {{ '#' }} PUBLIC NIC — held DOWN on purpose (#78). Leaving it undeclared does NOT leave it
        {{ '#' }} alone: an interface absent from networkConfig is unmanaged in the agent live
        {{ '#' }} environment, so NetworkManager DHCPs it, the provider's lease supplies a public
        {{ '#' }} resolver (8.8.8.8), and that outranks the static dns-resolver below. The node then
        {{ '#' }} cannot resolve {{ mirror_dns_name }}, the release image is unreachable, and the
        {{ '#' }} install stalls at "Cannot access Rendezvous Host" with every port refused.
        - name: {{ m.external_if }}
          type: ethernet
          state: down
          ipv4:
            enabled: false
            dhcp: false
            auto-dns: false
          ipv6:
            enabled: false
            dhcp: false
            autoconf: false
            auto-dns: false
{% endif %}
        - name: {{ m.parent_if }}.{{ vlan_vid }}
          type: vlan
          state: up
          vlan:
            base-iface: {{ m.parent_if }}
            id: {{ vlan_vid }}
          ipv4:
            enabled: true
            dhcp: false
            address:
              - ip: {{ m.vlan_ip }}
                prefix-length: {{ vlan_prefix }}
          ipv6:
            enabled: false
      dns-resolver:
        config:
          server:
            - {{ bastion_service_ip | default(bastion_vlan_ip) }}
      routes:
        config:
          - destination: 0.0.0.0/0
            next-hop-address: {{ bastion_vlan_ip }}
            next-hop-interface: {{ m.parent_if }}.{{ vlan_vid }}
{% endfor %}
